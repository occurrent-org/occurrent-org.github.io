---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { formatDate, newsPosts, postUrl } from "../../lib/news";

const posts = await newsPosts();
---

<StarlightPage frontmatter={{ title: "News", description: "Every Occurrent release, with what changed." }} hasSidebar={false}>
    <p>Every Occurrent release, newest first. Follow the development on <a href="https://github.com/johanhaleby/occurrent">GitHub</a>.</p>
    <ul class="news-list not-content">
        {
            posts.map((post) => (
                <li>
                    <a href={postUrl(post)}>
                        <span class="news-title">Occurrent {post.data.version}</span>
                        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
                        <span class="news-summary">{post.data.summary}</span>
                    </a>
                </li>
            ))
        }
    </ul>
</StarlightPage>

<style>
    .news-list {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 1rem;
    }
    .news-list a {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.25rem 1rem;
        padding: 1rem 1.25rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.5rem;
        color: var(--sl-color-gray-2);
        text-decoration: none;
    }
    .news-list a:hover {
        border-color: var(--sl-color-accent);
    }
    .news-title {
        font-size: var(--sl-text-xl);
        font-weight: 600;
        color: var(--sl-color-white);
    }
    .news-list time {
        color: var(--sl-color-gray-3);
        font-size: var(--sl-text-sm);
        align-self: center;
    }
    .news-summary {
        grid-column: 1 / -1;
    }
</style>
